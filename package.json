{
  "name": "pithos-ime-dictionary",
  "version": "0.0.0",
  "private": true,
  "description": "Mozc / Google 日本語入力のユーザー辞書。JSON で書いた辞書をインポート用の TSV に変換する",
  "type": "module",
  "scripts": {
    "build": "node src/build.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "prepare": "husky",
    "knip": "knip",
    "check": "tsc --noEmit"
  },
  "author": "pithos",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pithos-day/pithos-ime-dictionary.git"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.4.0",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@types/node": "^24.19.2",
    "husky": "^9.1.7",
    "knip": "^6.45.1",
    "lint-staged": "^17.6.0",
    "typescript": "^7.0.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,json,jsonc,yaml,yml,md}": "biome check --write --no-errors-on-unmatched"
  }
}
